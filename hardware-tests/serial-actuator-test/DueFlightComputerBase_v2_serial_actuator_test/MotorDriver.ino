/*
  MotorDriver.ino

  This tab controls the H-bridge motor driver on two PWM pins.

  You normally do not edit this file.
  Set command.motorPower inside userFlightLogic() instead.
*/

void setupMotor() {
  pinMode(MOTOR_PIN_A, OUTPUT);
  pinMode(MOTOR_PIN_B, OUTPUT);

  analogWrite(MOTOR_PIN_A, 0);
  analogWrite(MOTOR_PIN_B, 0);
}

void setMotorPower(int16_t power) {
  /*
    Controls motor power and direction.

    power = 0      -> motor off
    power = +255   -> full power one direction
    power = -255   -> full power the other direction
  */

  power = constrain(power, -MOTOR_MAX_POWER, MOTOR_MAX_POWER);

  if (power > -MOTOR_DEADBAND && power < MOTOR_DEADBAND) {
    power = 0;
  }

  if (power > 0) {
    analogWrite(MOTOR_PIN_A, power);
    analogWrite(MOTOR_PIN_B, 0);
  } else if (power < 0) {
    analogWrite(MOTOR_PIN_A, 0);
    analogWrite(MOTOR_PIN_B, -power);
  } else {
    analogWrite(MOTOR_PIN_A, 0);
    analogWrite(MOTOR_PIN_B, 0);
  }
}